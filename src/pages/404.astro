---
import Layout from "../components/Layout.astro";
---

<Layout title="Page Not Found | Joshua Miguel O. Macabalitao" description="The page you’re looking for could not be found.">
  <section class="container-shell section-space text-center">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 font-heading text-5xl font-semibold tracking-tight sm:text-6xl">Page not found</h1>
    <p class="mx-auto mt-5 max-w-xl leading-7 text-muted">The page you’re looking for could not be found.</p>
    <a class="button-primary mt-8" href={import.meta.env.BASE_URL}>Back to home</a>
  </section>
</Layout>
