---
import Layout from "../components/Layout.astro";
import SkillChips from "../components/SkillChips.astro";
import profile from "../content/profile.json";
---

<Layout title="About | Joshua Miguel O. Macabalitao" description="Learn about Joshua's accounting experience, information systems skills, and certifications.">
  <section class="container-shell section-space">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-8" data-reveal>
        <p class="eyebrow">About</p>
        <h1 class="mt-3 font-heading text-5xl font-semibold tracking-tight sm:text-6xl">Accounting, with a systems mindset.</h1>
        <p class="mt-6 text-lg leading-8 text-muted">{profile.about}</p>
        <p class="mt-4 leading-7 text-muted">{profile.location}</p>
      </div>
      <div class="md:col-span-4" data-reveal>
        <div class="flex aspect-[4/5] flex-col items-center justify-center rounded-2xl border border-line bg-accent/10 p-8 text-center">
          <span class="mb-4 inline-flex size-16 items-center justify-center rounded-full bg-paper text-2xl font-heading font-semibold text-accent" aria-hidden="true">JM</span>
          <p class="font-heading text-xl font-semibold">Photo placeholder</p>
        </div>
      </div>
    </div>
  </section>

  <section class="border-y border-line bg-accent/5">
    <div class="container-shell grid gap-8 py-14 md:grid-cols-12">
      <div class="md:col-span-3">
        <p class="eyebrow">Experience</p>
      </div>
      <div class="md:col-span-9">
        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <h2 class="font-heading text-2xl font-semibold">{profile.experience.role}</h2>
          <span class="text-sm text-muted">{profile.experience.period}</span>
        </div>
        <p class="mt-1 font-medium text-accent">{profile.experience.company}</p>
        <ul class="mt-5 grid gap-3">
          {profile.experience.responsibilities.map((item) => <li class="flex gap-3 leading-7 text-muted"><span class="mt-2 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="container-shell section-space">
    <div>
      <p class="eyebrow">Skills</p>
      <h2 class="mt-3 font-heading text-4xl font-semibold tracking-tight">What I work with</h2>
    </div>
    <div class="mt-9 grid gap-8 md:grid-cols-3">
      {profile.toolGroups.map((group) => (
        <section class="rounded-xl border border-line bg-paper p-6" data-reveal>
          <h3 class="font-heading text-lg font-semibold">{group.title}</h3>
          <div class="mt-4"><SkillChips skills={group.skills} /></div>
        </section>
      ))}
    </div>
  </section>

  <section class="border-t border-line bg-accent/5">
    <div class="container-shell grid gap-8 py-14 md:grid-cols-12">
      <div class="md:col-span-3">
        <p class="eyebrow">Certifications</p>
      </div>
      <div class="grid gap-4 md:col-span-9">
        {profile.certifications.map((certification) => (
          <article class="surface rounded-xl border border-line p-5 sm:flex sm:items-center sm:justify-between" data-reveal>
            <div>
              <h3 class="font-semibold">{certification.name}</h3>
              <p class="mt-1 text-sm text-muted">{certification.issuer}</p>
            </div>
            <p class="mt-3 text-sm text-muted sm:mt-0">{certification.date}</p>
          </article>
        ))}
        <a class="button-primary mt-3 w-fit" href={`${import.meta.env.BASE_URL}resume.pdf`} download>Download résumé <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>
</Layout>
