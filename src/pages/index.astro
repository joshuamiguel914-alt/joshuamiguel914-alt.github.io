---
import Layout from "../components/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SkillChips from "../components/SkillChips.astro";
import profile from "../content/profile.json";
import home from "../content/home.json";
import { Image } from "astro:assets";
import ledgerCover from "../assets/images/accounting-ledger.webp";
import softwareCover from "../assets/images/accounting-software.webp";
import systemsCover from "../assets/images/systems-flow.webp";

const projects = home.projects.map((project) => ({
  ...project,
  cover: project.slug === "remote-accounting-internship"
    ? ledgerCover
    : project.slug === "quickbooks-online-proadvisor"
      ? softwareCover
      : systemsCover,
}));
const sortedProjects = [...projects].sort((a, b) => Number(b.featured) - Number(a.featured));
---

<Layout
  title="Joshua Miguel O. Macabalitao | Accounting & Information Systems"
  description="Accounting and Information Systems professional in Metro Manila, bridging BIR-compliant bookkeeping and digital workflows."
>
  <section class="container-shell grid min-h-[70vh] items-center gap-10 py-16 md:grid-cols-12 md:py-24">
    <div class="md:col-span-8" data-reveal>
      <p class="eyebrow">Accounting × Information Systems</p>
      <h1 class="mt-5 max-w-4xl font-heading text-5xl font-semibold leading-[1.04] tracking-[-0.055em] sm:text-6xl lg:text-7xl">
        {profile.name}
      </h1>
      <p class="mt-4 text-sm font-semibold uppercase tracking-[0.08em] text-accent sm:text-base">{profile.title}</p>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-muted sm:text-xl">
        {home.valueStatement}
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="button-primary" href="#selected-work">See my work <span aria-hidden="true">↓</span></a>
        <a class="button-secondary" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/contact/`}>Contact me</a>
      </div>
      <p class="mt-8 text-sm text-muted">{profile.location}</p>
    </div>
    <div class="hidden md:col-span-4 md:block" data-reveal>
      <div class="rounded-2xl border border-line bg-accent/5 p-5">
        <Image src={ledgerCover} alt="Illustrated accounting ledger and journal entries" class="aspect-[4/5] w-full rounded-xl object-cover" widths={[360, 560]} sizes="(max-width: 1100px) 32vw, 350px" format="webp" loading="eager" />
      </div>
    </div>
  </section>

  <section id="selected-work" class="section-space bg-accent/5">
    <div class="container-shell">
      <div class="grid gap-4 md:grid-cols-12 md:items-end">
        <div class="md:col-span-8" data-reveal>
          <p class="eyebrow">Selected Work</p>
          <h2 class="mt-3 font-heading text-4xl font-semibold tracking-tight sm:text-5xl">Careful with the details.<br class="hidden sm:block" /> Curious about what’s next.</h2>
        </div>
        <p class="max-w-sm leading-7 text-muted md:col-span-4 md:justify-self-end" data-reveal>
          Practical accounting experience and information systems work, brought together.
        </p>
      </div>
      <div class="mt-10 grid gap-5 md:grid-cols-12">
        {sortedProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="section-space">
    <div class="container-shell grid gap-12 md:grid-cols-12 md:items-center">
      <div class="md:col-span-5" data-reveal>
        <div class="relative aspect-[4/5] overflow-hidden rounded-2xl border border-line bg-accent/10">
          <div class="absolute inset-0 flex flex-col items-center justify-center px-8 text-center">
            <span class="mb-4 inline-flex size-16 items-center justify-center rounded-full bg-paper text-2xl font-heading font-semibold text-accent" aria-hidden="true">JM</span>
            <p class="font-heading text-xl font-semibold">Photo placeholder</p>
            <p class="mt-2 max-w-xs text-sm leading-6 text-muted">Replace with a professional portrait of Joshua.</p>
          </div>
        </div>
      </div>
      <div class="md:col-span-7" data-reveal>
        <p class="eyebrow">A little about me</p>
        <h2 class="mt-3 font-heading text-4xl font-semibold tracking-tight">Numbers and systems, in the same conversation.</h2>
        <p class="mt-5 leading-8 text-muted">{profile.about}</p>
        <div class="mt-7">
          <h3 class="mb-3 text-sm font-semibold">Core competencies</h3>
          <SkillChips skills={profile.competencies.flatMap((group) => group.skills)} />
        </div>
        <a class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-accent" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/about/`}>
          More about me <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section-space bg-accent/5">
    <div class="container-shell grid gap-6 rounded-2xl border border-line bg-paper p-7 sm:p-10 md:grid-cols-12 md:items-center" data-reveal>
      <div class="md:col-span-8">
        <p class="eyebrow">Have a project in mind?</p>
        <h2 class="mt-3 font-heading text-3xl font-semibold tracking-tight sm:text-4xl">Let’s make the numbers and the workflow work.</h2>
      </div>
      <div class="md:col-span-4 md:justify-self-end">
        <a class="button-primary" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/contact/`}>Contact me <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>
</Layout>
