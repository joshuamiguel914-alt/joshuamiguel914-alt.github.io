---
import Layout from "../components/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import profile from "../content/profile.json";
---

<Layout title="Contact | Joshua Miguel O. Macabalitao" description="Get in touch with Joshua Miguel O. Macabalitao about accounting and information systems work.">
  <section class="container-shell section-space">
    <div class="grid gap-12 md:grid-cols-12">
      <div class="md:col-span-5" data-reveal>
        <p class="eyebrow">Contact</p>
        <h1 class="mt-3 font-heading text-5xl font-semibold tracking-tight sm:text-6xl">Let’s talk.</h1>
        <p class="mt-5 max-w-md leading-7 text-muted">Have a question or an opportunity to discuss? Send me a note and I’ll get back to you.</p>
        <dl class="mt-8 grid gap-5">
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-muted">Email</dt>
            <dd class="mt-1"><a class="font-medium text-accent underline decoration-accent/30 underline-offset-4" href={`mailto:${profile.email}`}>{profile.email}</a></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-muted">LinkedIn</dt>
            <dd class="mt-1"><a class="break-all font-medium text-accent underline decoration-accent/30 underline-offset-4" href={profile.linkedin} target="_blank" rel="noreferrer">{profile.linkedin}</a></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-muted">GitHub</dt>
            <dd class="mt-1"><a class="font-medium text-accent underline decoration-accent/30 underline-offset-4" href={profile.github} target="_blank" rel="noreferrer">{profile.github}</a></dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-muted">Phone</dt>
            <dd class="mt-1 text-ink">{profile.phone}</dd>
          </div>
          <div>
            <dt class="text-xs font-semibold uppercase tracking-wider text-muted">Location</dt>
            <dd class="mt-1 text-ink">{profile.location}</dd>
          </div>
        </dl>
      </div>
      <div class="surface rounded-2xl border border-line p-6 sm:p-8 md:col-span-7" data-reveal>
        <h2 class="font-heading text-2xl font-semibold">Send a message</h2>
        <p class="mt-2 text-sm leading-6 text-muted">Use the form below or email me directly at {profile.email}.</p>
        <div class="mt-7"><ContactForm /></div>
      </div>
    </div>
  </section>
</Layout>
