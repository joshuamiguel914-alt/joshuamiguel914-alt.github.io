---
import profile from "../content/profile.json";
---

<footer class="border-t border-line bg-paper">
  <div class="container-shell grid gap-8 py-10 md:grid-cols-12 md:items-end">
    <div class="md:col-span-6">
      <p class="font-heading text-xl font-semibold">{profile.name}</p>
      <p class="mt-2 max-w-md text-sm leading-6 text-muted">{profile.title}</p>
    </div>
    <div class="flex flex-col gap-2 text-sm md:col-span-4">
      <a class="w-fit text-muted transition hover:text-accent" href={`mailto:${profile.email}`}>{profile.email}</a>
      <span class="text-muted">{profile.location}</span>
    </div>
    <div class="flex gap-4 text-sm md:col-span-2 md:justify-end">
      <a class="text-muted transition hover:text-accent" href={profile.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <a class="text-muted transition hover:text-accent" href={profile.github} target="_blank" rel="noreferrer">GitHub</a>
    </div>
    <p class="border-t border-line pt-5 text-xs text-muted md:col-span-12">
      © {new Date().getFullYear()} {profile.name}
    </p>
  </div>
</footer>
