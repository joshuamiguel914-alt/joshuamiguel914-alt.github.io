---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  project: {
    slug: string;
    title: string;
    organization: string;
    role: string;
    date: string;
    outcome: string;
    cover: ImageMetadata;
    featured: boolean;
  };
}

const { project } = Astro.props;
const href = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/work/${project.slug}/`;
---

<article
  class:list={[
    "group surface card-lift overflow-hidden rounded-xl border border-line",
    project.featured ? "md:col-span-7" : "md:col-span-5 md:col-start-8",
  ]}
  data-reveal
>
  <a class="block h-full" href={href} aria-label={`Read case study: ${project.title}`}>
    <div class="relative aspect-[16/10] overflow-hidden bg-accent/10">
      <Image
        src={project.cover}
        alt={`${project.title} project cover`}
        class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.025]"
        widths={[480, 720, 960]}
        sizes="(max-width: 767px) 100vw, (max-width: 1100px) 60vw, 700px"
        format="webp"
        loading="lazy"
      />
      {project.featured && (
        <span class="absolute left-4 top-4 rounded-full bg-paper px-3 py-1.5 text-xs font-semibold text-accent">
          Featured
        </span>
      )}
    </div>
    <div class="p-5 sm:p-7">
      <div class="flex flex-wrap items-center justify-between gap-2 text-xs font-medium text-muted">
        <span>{project.organization}</span>
        <span>{project.date}</span>
      </div>
      <h3 class="mt-4 font-heading text-2xl font-semibold tracking-tight sm:text-3xl">{project.title}</h3>
      <p class="mt-2 text-sm font-medium text-accent">{project.role}</p>
      <p class="mt-4 max-w-xl leading-7 text-muted">{project.outcome}</p>
      <span class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-ink">
        View case study
        <span aria-hidden="true" class="transition group-hover:translate-x-1">→</span>
      </span>
    </div>
  </a>
</article>
