---
import ThemeToggle from "./ThemeToggle.astro";
const currentPath = import.meta.env.BASE_URL === "/"
  ? Astro.url.pathname
  : Astro.url.pathname.replace(import.meta.env.BASE_URL, "/");
const links = [
  { href: "/", label: "Home" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
];
---

<a class="sr-only fixed left-4 top-4 z-[60] rounded bg-paper p-3 text-ink focus:not-sr-only" href="#main-content">
  Skip to content
</a>
<header class="sticky top-0 z-50 border-b border-line bg-paper/95 backdrop-blur">
  <div class="container-shell flex min-h-[4.5rem] items-center justify-between gap-4">
    <a class="font-heading text-base font-bold tracking-tight sm:text-lg" href={import.meta.env.BASE_URL}>
      Joshua <span class="text-accent">Macabalitao</span>
    </a>
    <button
      id="menu-toggle"
      class="inline-flex size-10 items-center justify-center rounded-full border border-line md:hidden"
      type="button"
      aria-expanded="false"
      aria-controls="site-navigation"
      aria-label="Open navigation menu"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" class="size-5 fill-none stroke-current stroke-2">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
    </button>
    <nav
      id="site-navigation"
      aria-label="Main navigation"
      class="absolute left-0 right-0 top-full hidden border-b border-line bg-paper px-5 py-5 md:static md:block md:border-0 md:bg-transparent md:p-0"
    >
      <div class="container-shell flex flex-col items-stretch gap-4 md:w-auto md:flex-row md:items-center">
        <div class="flex flex-col gap-4 md:flex-row md:items-center md:gap-7">
          {links.map((link) => (
            <a
              href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}${link.href === "/" ? "/" : link.href}`}
              aria-current={currentPath === link.href || (link.href === "/" && currentPath === "/") ? "page" : undefined}
              class="text-sm font-medium text-muted transition hover:text-accent aria-[current=page]:text-accent"
            >
              {link.label}
            </a>
          ))}
          <a
            class="text-sm font-medium text-muted transition hover:text-accent"
            href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/#selected-work`}
          >
            Selected Work
          </a>
        </div>
        <div class="flex items-center gap-3 md:ml-1">
          <ThemeToggle />
          <a class="button-primary min-h-10 px-4 text-sm" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/contact/`}>
            Contact me
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>("#menu-toggle");
  const navigation = document.querySelector<HTMLElement>("#site-navigation");

  function closeMenu() {
    navigation?.classList.add("hidden");
    menuToggle?.setAttribute("aria-expanded", "false");
    menuToggle?.setAttribute("aria-label", "Open navigation menu");
  }

  menuToggle?.addEventListener("click", () => {
    const isOpen = menuToggle.getAttribute("aria-expanded") === "true";
    menuToggle.setAttribute("aria-expanded", String(!isOpen));
    menuToggle.setAttribute("aria-label", isOpen ? "Open navigation menu" : "Close navigation menu");
    navigation?.classList.toggle("hidden", isOpen);
  });

  navigation?.querySelectorAll("a").forEach((link) => link.addEventListener("click", closeMenu));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });
</script>
